{
  "name": "closer-together",
  "version": "1.0.0",
  "private": true,
  "description": "A little place for two: synchronized movies, video calls, and conversation.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "preview:build": "node scripts/build-preview.mjs",
    "test": "node --test test/server.test.js",
    "test:browser": "node scripts/browser-tests.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
